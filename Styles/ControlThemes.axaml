<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ControlTheme x:Key="RoundedAccentButtonTheme" TargetType="Button">
    <Setter Property="Background" Value="#5050FF" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Width" Value="105" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border x:Name="PART_Base"
                  Background="{TemplateBinding Background}"
                  CornerRadius="7" />
          <Border x:Name="PART_HoverOverlay"
                  Background="#19FFFFFF"
                  CornerRadius="7"
                  Opacity="0" />
          <Border x:Name="PART_PressedOverlay"
                  Background="#32000000"
                  CornerRadius="7"
                  Opacity="0" />
          <ContentPresenter Content="{TemplateBinding Content}"
                             Foreground="{TemplateBinding Foreground}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_HoverOverlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_PressedOverlay">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="RoundedGradientProgressBarTheme" TargetType="ProgressBar">
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="#19000000" />
    <Setter Property="Foreground" Value="#80000000" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border CornerRadius="6"
                Background="{TemplateBinding Background}"
                ClipToBounds="True">
          <Border x:Name="PART_Indicator"
                  Background="{TemplateBinding Foreground}"
                  HorizontalAlignment="Left"
                  CornerRadius="6"
                  ClipToBounds="True">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.4" Easing="CubicEaseOut" />
              </Transitions>
            </Border.Transitions>
            <Border x:Name="PART_Shine"
                    Width="70"
                    HorizontalAlignment="Left"
                    Margin="-70,0,0,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                  <GradientStop Offset="0" Color="#00000000" />
                  <GradientStop Offset="0.5" Color="#28000000" />
                  <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Styles>
                <Style Selector="Border#PART_Shine">
                  <Style.Animations>
                    <Animation Duration="0:0:2" IterationCount="INFINITE">
                      <KeyFrame Cue="0%">
                        <Setter Property="Margin" Value="-70,0,0,0" />
                      </KeyFrame>
                      <KeyFrame Cue="100%">
                        <Setter Property="Margin" Value="800,0,0,0" />
                      </KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </Border.Styles>
            </Border>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="IconToggleCheckBoxTheme" TargetType="CheckBox">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Background"
                CornerRadius="6"
                Background="Transparent">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="6">
            <Border x:Name="PART_CheckGlyph"
                    Width="12" Height="12"
                    CornerRadius="3"
                    BorderBrush="White"
                    BorderThickness="1.5"
                    Background="Transparent"
                    VerticalAlignment="Center" />
            <ContentPresenter Content="{TemplateBinding Content}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:checked /template/ Border#PART_CheckGlyph">
      <Setter Property="Background" Value="White" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Background">
      <Setter Property="Background" Value="#19FFFFFF" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="RoundedGroupBoxTheme" TargetType="HeaderedContentControl">
    <Setter Property="Background" Value="#19000000" />
    <Setter Property="Padding" Value="10,8,10,8" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                CornerRadius="6"
                Padding="{TemplateBinding Padding}">
          <DockPanel>
            <ContentPresenter DockPanel.Dock="Top"
                               Content="{TemplateBinding Header}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="13"
                               FontWeight="Bold"
                               Opacity="0.75"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6" />
            <ContentPresenter Content="{TemplateBinding Content}" />
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
