<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icons\computerRepairCentreIcon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>PlutoPoint_Installer</RootNamespace>
    <AssemblyName>Computer Repair Centre Installer</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <BaseOutputPath>bin\</BaseOutputPath>
    <PublishDir>bin\$(Platform)\$(Configuration)\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <!--
    Launcher and LauncherBeta are separate, related apps that live inside this
    repo but must never be compiled into this project. Plain evaluation-time
    Remove is used here (not a <Target>): evaluation always finishes in full
    before any target - including Avalonia's own GenerateAvaloniaResources -
    starts executing, so there is no ordering race to worry about here.
    AvaloniaXaml is included because Avalonia merges it into AvaloniaResource
    right before packing (see AvaloniaBuildTasks.targets: GenerateAvaloniaResources).
  -->
  <ItemGroup>
    <Compile Remove="Launcher\**;LauncherBeta\**" />
    <EmbeddedResource Remove="Launcher\**;LauncherBeta\**" />
    <None Remove="Launcher\**;LauncherBeta\**" />
    <AvaloniaResource Remove="Launcher\**;LauncherBeta\**" />
    <AvaloniaXaml Remove="Launcher\**;LauncherBeta\**" />
    <AdditionalFiles Remove="Launcher\**;LauncherBeta\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\icons\**" />
    <AvaloniaResource Include="Resources\images\**" />
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\**" Exclude="Resources\icons\**;Resources\images\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="AutoPublishSingleFile" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <CallTarget Targets="Publish" />
  </Target>

</Project>
