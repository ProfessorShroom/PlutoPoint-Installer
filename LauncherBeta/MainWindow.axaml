<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PlutoPoint_Launcher.MainWindow"
        Title="Computer Repair Centre Installer"
        Width="390" Height="329"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/computerRepairCentreIconBeta.ico"
        Background="#292929">

  <Window.Styles>
    <Style Selector="Ellipse.spinner">
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="-90" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="270" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto" Margin="24">
    <Grid Grid.Row="0" Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse Width="64" Height="64" StrokeThickness="6" Stroke="#3A3A3A" />
      <Ellipse x:Name="ProgressRing"
               Classes="spinner"
               Width="64" Height="64"
               StrokeThickness="6"
               Stroke="#4C9AFF"
               StrokeLineCap="Round">
        <Ellipse.RenderTransform>
          <RotateTransform Angle="-90" />
        </Ellipse.RenderTransform>
      </Ellipse>

      <TextBlock x:Name="PercentText"
                 IsVisible="False"
                 Text="0%"
                 FontSize="14"
                 Foreground="WhiteSmoke"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>

    <TextBlock Grid.Row="1"
               x:Name="StatusText"
               Text="Starting…"
               Foreground="WhiteSmoke"
               FontSize="13"
               HorizontalAlignment="Center"
               Margin="0,18,0,0" />
  </Grid>
</Window>
